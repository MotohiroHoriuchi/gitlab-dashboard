# GitLab connection (all required). Copy to .env.local for `npm run dev`,
# or to .env for docker-compose.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_ID=your-group/your-project
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional
# GITLAB_MAX_ISSUES=2000
# PORT=48273
# Label that marks an issue as a calendar "checkpoint" (★). Default: checkpoint
# CHECKPOINT_LABEL=checkpoint
